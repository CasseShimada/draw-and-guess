{
  "name": "@draw-guess/server",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts src/server.ts --format esm --platform node --target node24 --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@draw-guess/content": "workspace:*",
    "@draw-guess/game-rules": "workspace:*",
    "@draw-guess/protocol": "workspace:*",
    "@draw-guess/shared-types": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.2",
    "fastify": "5.10.0",
    "sharp": "0.35.3",
    "ws": "8.21.1",
    "zod": "4.4.3"
  }
}

# Central server: safe local defaults
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Comma-separated exact proxy source IPs; keep empty unless a controlled proxy is used.
TRUSTED_PROXY_ADDRESSES=
COOKIE_SECURE=false
ROOM_IDLE_TTL_MS=1800000
RECONNECT_GRACE_MS=10000
DESKTOP_SESSION_TTL_MS=43200000
TURN_RESULT_MS=5000
